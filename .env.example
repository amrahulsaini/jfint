# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables.

# ── Database (TiDB Cloud Serverless — MySQL wire compatible) ──────────────────
DB_HOST="gateway01.<region>.prod.aws.tidbcloud.com"
DB_PORT="4000"
DB_USER=""
DB_PASS=""
DB_NAME="jecr_2ndyear"
# TiDB Cloud requires TLS. Leave these on for any managed provider.
DB_SSL="true"
DB_SSL_REJECT_UNAUTHORIZED="true"
# Serverless functions each hold their own pool — keep this small.
DB_POOL_LIMIT="3"

# ── Static assets (Cloudflare R2) ─────────────────────────────────────────────
# Public base URL of the bucket. Unset = serve from public/ (local dev / old VM).
NEXT_PUBLIC_ASSET_BASE_URL="https://<your-r2-public-domain>"
# Credentials for writing photos back (app/api/pdf-save). Read-only viewers
# do not need these — the public base URL above is enough.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="jfint-assets"

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_PASSWORD=""
ADMIN_LOGIN_EMAIL=""
OTP_SECRET=""
# TEMPORARY: SMTP is dead because the jecrcfoundation.live domain lapsed, so no
# OTP email can be delivered. While this is "true", entering a @jecrc.ac.in
# address alone starts a session. Remove it the moment SMTP works again.
OTP_DISABLED="true"

# ── Email (unused while OTP_DISABLED is set) ──────────────────────────────────
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PAYMENT_AMOUNT_PAISE="1000"
ALL_ACCESS_AMOUNT_PAISE="1000"
COUPON_CODE=""

# ── RTU scraping ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_RTU_COOKIE=""
NEXT_PUBLIC_RTU_COLLEGE_ID="140"
NEXT_PUBLIC_RTU_COLLEGE_NAME=""

# ── Optional ──────────────────────────────────────────────────────────────────
# Without Redis the cache falls back to per-instance memory, which on serverless
# means a low hit rate but correct behaviour. Upstash Redis works here.
REDIS_URL=""
